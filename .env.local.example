# Newsly — environment template. Copy to .env.local and fill in real values.
# .env.local is gitignored; this .example file is safe to commit.

# Required — Groq API key for article summarization.
GROQ_API_KEY=your_key_here

# Optional — operational config. Defaults (shown) apply if unset.
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_MS=8000
BATCH_SIZE=3
BATCH_DELAY_MS=500
RSS_TIMEOUT_MS=10000
